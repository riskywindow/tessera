/* Generated by fake_driver/CMakeLists.txt from src/table.inc. Do not edit.
 *
 * An anonymous version node, so the exported symbols carry no version tag:
 * the real libcuda.so.1 has none, and a test binary linked against the
 * masquerading copy must be able to run against the real driver, or against
 * Tessera's shim, without a version dependency.
 *
 * The cu* list comes from the entry-point table, so the library cannot export
 * a driver symbol that cuGetProcAddress does not know about, or the other way
 * round. Everything not listed here is local.
 */
{
  global:
@TF_EXPORT_LIST@    tf_*;
  local:
    *;
};
